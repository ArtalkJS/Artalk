{
  "name": "eslint-plugin-artalk",
  "version": "1.0.3",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/ArtalkJS/Artalk/tree/master/ui/eslint-plugin-artalk",
  "bugs": "https://github.com/ArtalkJS/Artalk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtalkJS/Artalk.git",
    "directory": "ui/eslint-plugin-artalk"
  },
  "files": [
    "dist"
  ],
  "main": "dist/main.cjs",
  "types": "dist/main.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/main.cjs"
      },
      "default": {
        "types": "./dist/main.d.mts",
        "default": "./dist/main.mjs"
      }
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest",
    "test:attw": "pnpx @arethetypeswrong/cli@0.18.5 --pack ."
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.65.0"
  },
  "devDependencies": {
    "@typescript-eslint/rule-tester": "^8.65.0",
    "eslint": "^10.8.0",
    "tsdown": "^0.22.14"
  },
  "peerDependencies": {
    "eslint": ">=9"
  }
}
