{
  "compilerOptions": {
    "composite": true,
    "rootDir": "..",
    "types": ["vite/client"],
    "resolveJsonModule": true,
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "**/.vitepress/**/*.ts",
    "**/.vitepress/**/*.mts",
    "**/.vitepress/**/*.vue",
    "../shared"
  ],
  "exclude": ["node_modules"]
}
