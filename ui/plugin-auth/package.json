{
  "name": "@artalk/plugin-auth",
  "version": "0.0.3",
  "minAppVersion": "2.10.0",
  "license": "LGPL-3.0-only",
  "description": "Auth plugin for artalk",
  "homepage": "https://github.com/ArtalkJS/Artalk/tree/master/ui/plugin-auth",
  "bugs": "https://github.com/ArtalkJS/Artalk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtalkJS/Artalk.git",
    "directory": "ui/plugin-auth"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/artalk-plugin-auth.js",
  "module": "./dist/artalk-plugin-auth.mjs",
  "types": "./dist/artalk-plugin-auth.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/artalk-plugin-auth.d.ts",
        "default": "./dist/artalk-plugin-auth.mjs"
      },
      "require": {
        "types": "./dist/artalk-plugin-auth.d.cts",
        "default": "./dist/artalk-plugin-auth.cjs"
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "test:attw": "pnpx @arethetypeswrong/cli@0.18.5 --pack ."
  },
  "devDependencies": {
    "@artalk/plugin-kit": "workspace:^",
    "artalk": "workspace:^",
    "solid-js": "^1.9.14",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vite-plugin-solid": "^2.11.13"
  },
  "peerDependencies": {
    "artalk": "^2.10.0"
  }
}
